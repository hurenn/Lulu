--- !u!114 &6086241588923132022
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9d01984c64812b9448751b37fd617dba, type: 3}
  m_Name: MessagePlayableAsset(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  messageDatas:
  - text: "\u3046\u3080\u3002\u3067\u306F\u65E9\u304F\u3053\u3053\u304B\u3089\u96E2\u308C\u308B\u3068\u3057\u3088\u3046\u3002\n\u305D\u308D\u305D\u308D\u5927\u4EBA\u305F\u3061\u3082\u5230\u7740\u3059\u308B\u9803\u5408\u3044\u3060\u308D\u3046\u3057\u306A\u3002"
    englishText: "Well then, let\u2019s get out of here.\nThe adults should be arriving
      any minute now."
    characterIcon: {fileID: 21300000, guid: f6389e54db455ce4aa0a012ed47c6a25, type: 3}
    addShowTime: 0
    isAutoForce: 0
    isUnScaledTime: 0
  - text: "\u3042\u3042\u3002\u307E\u305F\u6012\u3089\u308C\u308B\u306E\u306F\u3054\u3081\u3093\u3060\u3002"
    englishText: "Yeah... I\u2019d rather not get another lecture."
    characterIcon: {fileID: 21300000, guid: 5697ec96c8bffbb419d192c29b731381, type: 3}
    addShowTime: 0
    isAutoForce: 0
    isUnScaledTime: 0
  - text: "\u306F\u3063\u306F\u3063\u306F\uFF01\n\u975E\u516C\u5F0F\u6D3B\u52D5\u306E\u8F9B\u3044\u3068\u3053\u308D\u3060\u306A\uFF01"
    englishText: 'Ha ha ha!

      The hardships of an unofficial mission, eh?'
    characterIcon: {fileID: 21300000, guid: 846575d3ed56a44438cac6995f860ebe, type: 3}
    addShowTime: 0
    isAutoForce: 0
    isUnScaledTime: 0
  - text: "\u3055\u3042\u3001\u884C\u3053\u3046\u3002\u30DF\u30EA\u30FC\u3002\n\u7ACB\u3066\u308B\uFF1F"
    englishText: "Come on, Milly\u2026 \nCan you stand?"
    characterIcon: {fileID: 21300000, guid: 8f037a52c0459f341ab9ec2c590a8b6f, type: 3}
    addShowTime: 0
    isAutoForce: 0
    isUnScaledTime: 0
  - text: "\u306F\u3044\u3063\uFF01"
    englishText: Yes!
    characterIcon: {fileID: 21300000, guid: 0040aa3c9de3b45418f2080e41781db9, type: 3}
    addShowTime: 0
    isAutoForce: 0
    isUnScaledTime: 0
  shakeWindow: 0
  shakeIntensity: 20
  shakeDuration: 0.4
