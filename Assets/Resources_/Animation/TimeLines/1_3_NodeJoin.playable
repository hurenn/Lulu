  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9d01984c64812b9448751b37fd617dba, type: 3}
  m_Name: MessagePlayableAsset(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  messageDatas:
  - text: "\u2026\u2026\u30C3"
    englishText: ...
    characterIcon: {fileID: 21300000, guid: 3727daa9959b89b47aacc2acbc499d30, type: 3}
    addShowTime: 0
    isAutoForce: 0
    isUnScaledTime: 0
  - text: "\u2026\u2026\u30DF\u30EA\u30FC\u304C\u6575\u306B\u3055\u3089\u308F\u308C\u305F\u3002\n\u30AA\u30EC\u306E\u529B\u4E0D\u8DB3\u306E\u305B\u3044\u3067\u2026\u2026\uFF01\uFF01"
    englishText: '...The enemy took Milly.

      It was my fault...

      I wasn''t
      strong enough...!!'
    characterIcon: {fileID: 21300000, guid: 3727daa9959b89b47aacc2acbc499d30, type: 3}
    addShowTime: 0
    isAutoForce: 0
    isUnScaledTime: 0
  shakeWindow: 0
