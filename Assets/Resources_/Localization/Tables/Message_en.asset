%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Message_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 1220990e41f024342b0386f72e02de0f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1000229711872
    m_Localized: Hello, this is a test message.
    m_Metadata:
      m_Items: []
  - m_Id: 8691631140864
    m_Localized: "That wall on the right looks thin too \u2014 I bet we can go through
      it!"
    m_Metadata:
      m_Items: []
  - m_Id: 8691635335168
    m_Localized: <color=yellow>Hold right and mash B</color> to warp straight through
      it!
    m_Metadata:
      m_Items: []
  - m_Id: 303919449649152
    m_Localized: Goal!
    m_Metadata:
      m_Items: []
  - m_Id: 303919449649153
    m_Localized: 'That was awesome!

      You might even be a better warper than
      me!!'
    m_Metadata:
      m_Items: []
  - m_Id: 303923023196160
    m_Localized: "Huh, what\u2019s up with this one coin?"
    m_Metadata:
      m_Items: []
  - m_Id: 303924394733568
    m_Localized: We made it!
    m_Metadata:
      m_Items: []
  - m_Id: 303924394733569
    m_Localized: 'Umm... there weren''t any rare items in here, but...

      Nice
      job! You''re awesome! You''re the best!'
    m_Metadata:
      m_Items: []
  - m_Id: 303925598498816
    m_Localized: We did it! That was awesome!
    m_Metadata:
      m_Items: []
  - m_Id: 303926374445056
    m_Localized: Goal!
    m_Metadata:
      m_Items: []
  - m_Id: 303926374445057
    m_Localized: 'Wow! New best time!

      You''ve totally mastered warping!'
    m_Metadata:
      m_Items: []
  - m_Id: 303927880200192
    m_Localized: Eeeek!!
    m_Metadata:
      m_Items: []
  - m_Id: 303927880200193
    m_Localized: ...That ledge is a bit too high to reach.
    m_Metadata:
      m_Items: []
  - m_Id: 303927880200194
    m_Localized: 'You can warp diagonally, too.

      Try <color=yellow>holding
      Up-Right and pressing B</color>!'
    m_Metadata:
      m_Items: []
  - m_Id: 303929742471168
    m_Localized: '<color=yellow>Move left and right with the D-pad!</color>

      Double-tap
      it to start running!'
    m_Metadata:
      m_Items: []
  - m_Id: 303930614886400
    m_Localized: Goal!
    m_Metadata:
      m_Items: []
  - m_Id: 303930614886401
    m_Localized: 'Nice time!

      Getting the hang of warping yet?'
    m_Metadata:
      m_Items: []
  - m_Id: 303932087087104
    m_Localized: 'Wow, wow! We made it across that huge gap!

      I knew your power
      was the real deal!'
    m_Metadata:
      m_Items: []
  - m_Id: 303932087087105
    m_Localized: 'Hey, Player!

      You''ll stay on my side from now on... right?'
    m_Metadata:
      m_Items: []
  - m_Id: 303932087087106
    m_Localized: You know, I want to become this city's hero.
    m_Metadata:
      m_Items: []
  - m_Id: 303932087087107
    m_Localized: 'That''s why I''m part of the School Defense Club,

      protecting
      the peace of this town.'
    m_Metadata:
      m_Items: []
  - m_Id: 303932087087108
    m_Localized: 'A little while ago, one of my teammates

      reported that enemies
      had appeared.

      Come on, Player! Let''s hurry!'
    m_Metadata:
      m_Items: []
  - m_Id: 303933236326400
    m_Localized: Goal!
    m_Metadata:
      m_Items: []
  - m_Id: 303933236326401
    m_Localized: 'Think you''ve got the course down?

      Come on, let''s run it
      again!'
    m_Metadata:
      m_Items: []
  - m_Id: 303933748031488
    m_Localized: "Yeah, that\u2019s it!\nNow I can warp straight down!"
    m_Metadata:
      m_Items: []
  - m_Id: 303933748031489
    m_Localized: <color=yellow>Hold Down and mash B</color> to warp all the way down!
    m_Metadata:
      m_Items: []
  - m_Id: 303935237009408
    m_Localized: 'This is the Time Attack course.

      Looks like we can''t go
      in right now.'
    m_Metadata:
      m_Items: []
  - m_Id: 303936730181632
    m_Localized: Woohoo! So many coins!
    m_Metadata:
      m_Items: []
  - m_Id: 303937686482944
    m_Localized: "<color=yellow>Press B on the ground, and I\u2019ll jump!"
    m_Metadata:
      m_Items: []
  - m_Id: 303937686482945
    m_Localized: In the air, <color=yellow>hold a direction and press B</color> to
      warp!
    m_Metadata:
      m_Items: []
  - m_Id: 303938714087424
    m_Localized: "Oh! If <color=yellow>my gauge runs out</color>, <color=yellow>I
      won\u2019t be able to warp</color> for a bit!"
    m_Metadata:
      m_Items: []
  - m_Id: 303938714087425
    m_Localized: "So <color=yellow>I gotta land</color> before it\u2019s empty and
      <color=yellow>let it recharge</color>, okay?"
    m_Metadata:
      m_Items: []
  - m_Id: 303939490033664
    m_Localized: Whoosh!
    m_Metadata:
      m_Items: []
  - m_Id: 303940739936256
    m_Localized: Waaahhh!!
    m_Metadata:
      m_Items: []
  - m_Id: 303940739936257
    m_Localized: "\u2026I missed my step."
    m_Metadata:
      m_Items: []
  - m_Id: 303940739936258
    m_Localized: If <color=yellow>I warp into a thick wall</color>, I can scramble
      right up it!
    m_Metadata:
      m_Items: []
  - m_Id: 303942199554048
    m_Localized: "Whoa, there are tons of coins here too!\nWanna grab \u2019em all?"
    m_Metadata:
      m_Items: []
  - m_Id: 303942199554049
    m_Localized: If I grab tons of coins, I level up and my health and gauge go up!
    m_Metadata:
      m_Items: []
  - m_Id: 303942900002816
    m_Localized: "Alright, let\u2019s keep going!\nI\u2019m counting on you, Player!"
    m_Metadata:
      m_Items: []
  - m_Id: 305880043499520
    m_Localized: If you press the <color=yellow>A button</color>, Marlica will attack
      right away.
    m_Metadata:
      m_Items: []
  - m_Id: 305886976684032
    m_Localized: Hold X and just dash right through!
    m_Metadata:
      m_Items: []
  - m_Id: 305887685521408
    m_Localized: Enemy!
    m_Metadata:
      m_Items: []
  - m_Id: 305887685521409
    m_Localized: "<color=yellow>If there\u2019s an enemy in front of us</color>,
      I\u2019ll attack it with fire, okay?"
    m_Metadata:
      m_Items: []
  - m_Id: 305888398553088
    m_Localized: Marlica, have you seen Pepe or Node?
    m_Metadata:
      m_Items: []
  - m_Id: 305888398553089
    m_Localized: Nope. I've only been looking at you, Lulu-chan.
    m_Metadata:
      m_Items: []
  - m_Id: 305888398553090
    m_Localized: I see. Well, I guess that can't be helped.
    m_Metadata:
      m_Items: []
  - m_Id: 305889136750592
    m_Localized: "There are enemies here too\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 305890109829120
    m_Localized: <color=yellow>Hold X</color> and charge right through the beam!
    m_Metadata:
      m_Items: []
  - m_Id: 305890797694976
    m_Localized: "\u2026If you invincible while glowing, why not just stay glowing
      forever?"
    m_Metadata:
      m_Items: []
  - m_Id: 305890797694977
    m_Localized: "Ha ha ha! Well, that\u2019s true!\nThere\u2019s no real downside
      to staying glowing!"
    m_Metadata:
      m_Items: []
  - m_Id: 305890797694978
    m_Localized: "Well\u2026 except it gets exhausting\u2026 for me!"
    m_Metadata:
      m_Items: []
  - m_Id: 305890797694979
    m_Localized: "And the player\u2019s fingers, too."
    m_Metadata:
      m_Items: []
  - m_Id: 305891380703232
    m_Localized: "<color=yellow>Hold X</color> and I'm invincible!\n\nJust keep holding
      it\u2014don\u2019t mash the button!"
    m_Metadata:
      m_Items: []
  - m_Id: 305892009848832
    m_Localized: Oh. An enemy.
    m_Metadata:
      m_Items: []
  - m_Id: 305892014043136
    m_Localized: '...Too bad, but we can''t defeat it yet.

      We''ll just have
      to dodge it and keep going.'
    m_Metadata:
      m_Items: []
  - m_Id: 305892014043137
    m_Localized: 'You know, one of my friends

      has powers that are great for
      fighting.'
    m_Metadata:
      m_Items: []
  - m_Id: 305892014043138
    m_Localized: 'They''re probably nearby.

      I bet we''ll run into them before
      long!'
    m_Metadata:
      m_Items: []
  - m_Id: 306011086139392
    m_Localized: 'By the way, Node...

      What was the enemy who took Milly-chan
      like?'
    m_Metadata:
      m_Items: []
  - m_Id: 306011086139393
    m_Localized: 'Yeah...

      An explosive-type Ability user...

      Strong
      enough to blow my ice away...'
    m_Metadata:
      m_Items: []
  - m_Id: 306011086139394
    m_Localized: "So\u2026 you lost?"
    m_Metadata:
      m_Items: []
  - m_Id: 306011086139395
    m_Localized: 'I didn''t lose!

      That bastard grabbed Milly and ran off on
      his own!'
    m_Metadata:
      m_Items: []
  - m_Id: 306011086139396
    m_Localized: 'A kidnapper...

      Then the recent disappearances of Ability
      users around town

      may not be unrelated.'
    m_Metadata:
      m_Items: []
  - m_Id: 306011086139397
    m_Localized: So it really was Dark World, the evil organization.
    m_Metadata:
      m_Items: []
  - m_Id: 306011086139398
    m_Localized: 'We have to save Milly-chan quickly.

      Right, Player?'
    m_Metadata:
      m_Items: []
  - m_Id: 306012113743872
    m_Localized: <color=yellow>Hit Y</color> and Node will unleash a powerful attack!
    m_Metadata:
      m_Items: []
  - m_Id: 306012113743873
    m_Localized: <color=yellow>Mash Y</color> to keep the combo going!
    m_Metadata:
      m_Items: []
  - m_Id: 306012906467328
    m_Localized: Tough enemy? Time for Node to shine!
    m_Metadata:
      m_Items: []
  - m_Id: 306012906467329
    m_Localized: Go, Node! Ice Blade, now!
    m_Metadata:
      m_Items: []
  - m_Id: 306012906467330
    m_Localized: "\u2026\u2026\u2026\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 306012914855936
    m_Localized: "Ugh, he\u2019s totally ignoring us!"
    m_Metadata:
      m_Items: []
  - m_Id: 306012914855937
    m_Localized: Do we not have enough badges or what!?
    m_Metadata:
      m_Items: []
  - m_Id: 306012914855938
    m_Localized: "\u2026Are they talking about some game\u2026?"
    m_Metadata:
      m_Items: []
  - m_Id: 306013669830656
    m_Localized: "Grrgh\u2026!!"
    m_Metadata:
      m_Items: []
  - m_Id: 306013669830657
    m_Localized: Big Brother...!
    m_Metadata:
      m_Items: []
  - m_Id: 306013669830658
    m_Localized: 'Milly...!!

      Damn it... Come back!!'
    m_Metadata:
      m_Items: []
  - m_Id: 306013669830659
    m_Localized: "That voice\u2026 was that\u2014"
    m_Metadata:
      m_Items: []
  - m_Id: 306013669830660
    m_Localized: "Let\u2019s hurry!"
    m_Metadata:
      m_Items: []
  - m_Id: 306014470942720
    m_Localized: ...What's with this one coin?
    m_Metadata:
      m_Items: []
  - m_Id: 306014470942721
    m_Localized: 'We finally found a secret room...

      and this is all we get?'
    m_Metadata:
      m_Items: []
  - m_Id: 306014470942722
    m_Localized: 'And yet, was it not fun?

      Perhaps the adventure itself was
      the true reward.'
    m_Metadata:
      m_Items: []
  - m_Id: 306014470942723
    m_Localized: 'I told you to hurry!

      Quit screwing around and keep moving!'
    m_Metadata:
      m_Items: []
  - m_Id: 306014470942724
    m_Localized: ...The Player told me to go this way.
    m_Metadata:
      m_Items: []
  - m_Id: 306017012690944
    m_Localized: 'Excellent! The School Defense Club is finally all together!

      Now,
      let us rescue Milly!'
    m_Metadata:
      m_Items: []
  - m_Id: 306017012690945
    m_Localized: 'A hero who dodges every attack,

      chases down anyone who tries
      to run,

      and corners them with teleportation...

      Sounds unstoppable.'
    m_Metadata:
      m_Items: []
  - m_Id: 306017012690946
    m_Localized: That sounds way worse than you meant it to.
    m_Metadata:
      m_Items: []
  - m_Id: 306017499230208
    m_Localized: 'Look, Lulu-chan.

      That''s the place we went shopping together.'
    m_Metadata:
      m_Items: []
  - m_Id: 306017499230209
    m_Localized: "Oh, you're right! \nWe can see it from here!"
    m_Metadata:
      m_Items: []
  - m_Id: 306017499230210
    m_Localized: You two done?
    m_Metadata:
      m_Items: []
  - m_Id: 306017499230211
    m_Localized: 'Look, Node!

      That''s the movie theater I''ve been wanting
      to check out!'
    m_Metadata:
      m_Items: []
  - m_Id: 306017499230212
    m_Localized: Who cares? Go by yourself.
    m_Metadata:
      m_Items: []
  - m_Id: 306018291953664
    m_Localized: "<color=yellow>If I warp straight into an enemy</color>, \nNode
      will attack automatically!"
    m_Metadata:
      m_Items: []
  - m_Id: 306018879156224
    m_Localized: Hup!
    m_Metadata:
      m_Items: []
  - m_Id: 306018879156225
    m_Localized: "\u2026Wow, look at that! We made it so high up!\nHey, hey, Marlica,
      look! There are so many coins!"
    m_Metadata:
      m_Items: []
  - m_Id: 306018879156226
    m_Localized: "That\u2019s great. Good for you.\n\u2026Well, looks like this is
      a dead end, so let\u2019s head back."
    m_Metadata:
      m_Items: []
  - m_Id: 306018879156227
    m_Localized: "\u2026Okay."
    m_Metadata:
      m_Items: []
  - m_Id: 306019487330304
    m_Localized: Move! You worthless trash!!
    m_Metadata:
      m_Items: []
  - m_Id: 306019487330305
    m_Localized: 'That tough enemy is up on the platform.

      It''s hard to hit
      from here.'
    m_Metadata:
      m_Items: []
  - m_Id: 306019487330306
    m_Localized: I'll hit it with my fire and lock on, okay?
    m_Metadata:
      m_Items: []
  - m_Id: 306019487330307
    m_Localized: 'Press <color=yellow>Y while locked on</color>

      to warp right
      in front of the enemy and attack!'
    m_Metadata:
      m_Items: []
  - m_Id: 306019487330308
    m_Localized: 'Lock on with A, then attack with Y!

      That''s the basic combo!'
    m_Metadata:
      m_Items: []
  - m_Id: 306020112281600
    m_Localized: It's up ahead! Hurry!!
    m_Metadata:
      m_Items: []
  - m_Id: 306021110525952
    m_Localized: Heh, up we go!
    m_Metadata:
      m_Items: []
  - m_Id: 306021190217728
    m_Localized: Got it.
    m_Metadata:
      m_Items: []
  - m_Id: 306021190217729
    m_Localized: "\u2026Wait, didn\u2019t we just totally skip a bunch of stuff?"
    m_Metadata:
      m_Items: []
  - m_Id: 306021190217730
    m_Localized: "Faster\u2019s always better, huh?"
    m_Metadata:
      m_Items: []
  - m_Id: 306021190217731
    m_Localized: Yep! No problemo!
    m_Metadata:
      m_Items: []
  - m_Id: 306155152093184
    m_Localized: "Something\u2019s coming!"
    m_Metadata:
      m_Items: []
  - m_Id: 306155152093185
    m_Localized: <color=yellow>Keep holding the X button!
    m_Metadata:
      m_Items: []
  - m_Id: 306160365613056
    m_Localized: Looks like they're starting to panic.
    m_Metadata:
      m_Items: []
  - m_Id: 306160365613057
    m_Localized: Hehe... I'm kinda freaking out too.
    m_Metadata:
      m_Items: []
  - m_Id: 306160365613058
    m_Localized: 'If the attacks get too intense,

      there''s no shame in staying
      invincible until you spot an opening!'
    m_Metadata:
      m_Items: []
  - m_Id: 306160365613059
    m_Localized: 'We''re almost there, Lulu-chan.

      Just a little more, okay?'
    m_Metadata:
      m_Items: []
  - m_Id: 306160365613060
    m_Localized: Yep! I'll give it everything I've got!
    m_Metadata:
      m_Items: []
  - m_Id: 306160365613061
    m_Localized: "We\u2019re the heroes who protect this town!\nThe School Defense
      Club will defeat all the evil enemies!"
    m_Metadata:
      m_Items: []
  - m_Id: 306161888145408
    m_Localized: "This is crazy\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 306161888145409
    m_Localized: "That\u2019s cheating, isn\u2019t it?"
    m_Metadata:
      m_Items: []
  - m_Id: 306161888145410
    m_Localized: That won't work on you anyway.
    m_Metadata:
      m_Items: []
  - m_Id: 306162479542272
    m_Localized: We made it!!
    m_Metadata:
      m_Items: []
  - m_Id: 306162479542273
    m_Localized: "We did\u2026!"
    m_Metadata:
      m_Items: []
  - m_Id: 306163268071424
    m_Localized: From up there, my fire should be able to reach them more easily.
    m_Metadata:
      m_Items: []
  - m_Id: 306163268071425
    m_Localized: 'Stay back.

      You won''t take them down with those attacks
      anyway.'
    m_Metadata:
      m_Items: []
  - m_Id: 306163268071426
    m_Localized: "Hm\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 306163268071427
    m_Localized: "\u2026Just don't get so carried away fighting up close that you
      get yourself hit, okay?"
    m_Metadata:
      m_Items: []
  - m_Id: 306163268071428
    m_Localized: ...What?
    m_Metadata:
      m_Items: []
  - m_Id: 306163268071429
    m_Localized: 'Hahaha!

      It''s wonderful to see you two getting along so
      well!'
    m_Metadata:
      m_Items: []
  - m_Id: 306163268071430
    m_Localized: "Marlica, let's show them how \u2018close\u2019 we are too!"
    m_Metadata:
      m_Items: []
  - m_Id: 306163268071431
    m_Localized: "\u2026Okay.\nI'll let you know when my charge is ready."
    m_Metadata:
      m_Items: []
  - m_Id: 306163985297408
    m_Localized: "Okay! Let\u2019s roll, guys!"
    m_Metadata:
      m_Items: []
  - m_Id: 306165235200000
    m_Localized: "\u2026Hey, that thing he\u2019s wearing looks kinda cool\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 306165235200001
    m_Localized: "Really?\nI bet it\u2019s super heavy, he won\u2019t be moving anywhere
      from there."
    m_Metadata:
      m_Items: []
  - m_Id: 306165235200002
    m_Localized: "\u2026Like a cat that climbs up and can\u2019t get down?"
    m_Metadata:
      m_Items: []
  - m_Id: 306165235200003
    m_Localized: Maybe he hates low ground.
    m_Metadata:
      m_Items: []
  - m_Id: 306165235200004
    m_Localized: Ugh, who cares. Quit rambling.
    m_Metadata:
      m_Items: []
  - m_Id: 306166233444352
    m_Localized: When you see the warning beam, the laser's coming.
    m_Metadata:
      m_Items: []
  - m_Id: 306166233444353
    m_Localized: 'Don''t forget!

      <color=yellow>Hold X to become invincible!</color>'
    m_Metadata:
      m_Items: []
  - m_Id: 306166233444354
    m_Localized: Lulu-chan, couldn't you dodge them even without becoming invincible?
    m_Metadata:
      m_Items: []
  - m_Id: 306166233444355
    m_Localized: 'Leave it to me!

      I just have to dodge the warning beam, right?'
    m_Metadata:
      m_Items: []
  - m_Id: 306166233444356
    m_Localized: There's no downside, so make good use of my ability too!
    m_Metadata:
      m_Items: []
  - m_Id: 306659869470720
    m_Localized: "Ah, that was close\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 306659869470721
    m_Localized: "\u2026\u2026\u2026\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 306659869470722
    m_Localized: "\u2026You\u2026 could it be that you\u2019re the player?"
    m_Metadata:
      m_Items: []
  - m_Id: 306659869470723
    m_Localized: 'Amazing! It actually connected!

      Ah, thank you for helping
      me!'
    m_Metadata:
      m_Items: []
  - m_Id: 306660863520768
    m_Localized: "I\u2019m Lulu!\nNice to meet you from now on!"
    m_Metadata:
      m_Items: []
  - m_Id: 306662553825280
    m_Localized: "\u2026\u2026Wait\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 306663455600640
    m_Localized: Could you be the Player!?
    m_Metadata:
      m_Items: []
  - m_Id: 306664336404480
    m_Localized: "\u2026Wait, this isn\u2019t the time for introductions\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 306665242374144
    m_Localized: This floor looks thin enough to pass through.
    m_Metadata:
      m_Items: []
  - m_Id: 306665246568448
    m_Localized: "Let\u2019s go together, Player! I\u2019ll follow your inputs!"
    m_Metadata:
      m_Items: []
  - m_Id: 306667410829312
    m_Localized: <color=yellow>Hold down and hit the B button!
    m_Metadata:
      m_Items: []
  - m_Id: 306668270661632
    m_Localized: "Owieee\u2026\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 306668870447104
    m_Localized: Waaahhh!!
    m_Metadata:
      m_Items: []
  - m_Id: 306669587673088
    m_Localized: "Whoa, awesome! It actually worked\u2014we really connected!\nOh!
      I\u2019m Lulu! Nice meeting you!"
    m_Metadata:
      m_Items: []
  - m_Id: 306670514614272
    m_Localized: Looks like I fell into an abandoned building.
    m_Metadata:
      m_Items: []
  - m_Id: 306672829870080
    m_Localized: "There\u2019s another enemy. \nLet\u2019s dodge so we don\u2019t
      get hit, and\u2014"
    m_Metadata:
      m_Items: []
  - m_Id: 306674960576512
    m_Localized: Marlica!
    m_Metadata:
      m_Items: []
  - m_Id: 306675585527808
    m_Localized: Are you okay, Lulu-chan?
    m_Metadata:
      m_Items: []
  - m_Id: 306676374056960
    m_Localized: Yeah, thank you!
    m_Metadata:
      m_Items: []
  - m_Id: 306676374056961
    m_Localized: "I heard a strong enemy showed up\u2014let\u2019s go together!"
    m_Metadata:
      m_Items: []
  - m_Id: 306677300998144
    m_Localized: Yeah.
    m_Metadata:
      m_Items: []
  - m_Id: 306678353768448
    m_Localized: Marlica has joined!
    m_Metadata:
      m_Items: []
  - m_Id: 306679368790016
    m_Localized: Huh?
    m_Metadata:
      m_Items: []
  - m_Id: 306680929071104
    m_Localized: 'My princess!

      Marlica''s with you too, I see!'
    m_Metadata:
      m_Items: []
  - m_Id: 306681608548352
    m_Localized: 'Pepe!

      There you are! I found you!'
    m_Metadata:
      m_Items: []
  - m_Id: 306682254471168
    m_Localized: Much obliged!
    m_Metadata:
      m_Items: []
  - m_Id: 306682254471169
    m_Localized: 'I, Peperiel Aa-Zeragaruk, shall be your knight and guard you, my
      princess!

      Ha-ha-ha!!'
    m_Metadata:
      m_Items: []
  - m_Id: 306683131080704
    m_Localized: Pepe has joined!
    m_Metadata:
      m_Items: []
  - m_Id: 306685509251072
    m_Localized: "\u2026Aren\u2019t we just gonna leave him behind? He\u2019s way
      too loud\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 306686125813760
    m_Localized: 'Yeah, yeah, I got it.

      Come on, let''s go.'
    m_Metadata:
      m_Items: []
  - m_Id: 306686574604288
    m_Localized: ...Yikes.
    m_Metadata:
      m_Items: []
  - m_Id: 306687249887232
    m_Localized: "No way, I\u2019m not saying that."
    m_Metadata:
      m_Items: []
  - m_Id: 306687946141696
    m_Localized: 'Which is why... please help me!

      I beg of you!'
    m_Metadata:
      m_Items: []
  - m_Id: 306689179267072
    m_Localized: 'Indeed!

      As you can plainly see, this place is crawling with
      traps!'
    m_Metadata:
      m_Items: []
  - m_Id: 306690882154496
    m_Localized: "\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 306691242864640
    m_Localized: Hold down X!
    m_Metadata:
      m_Items: []
  - m_Id: 306693507788800
    m_Localized: You alright!?
    m_Metadata:
      m_Items: []
  - m_Id: 306694816411648
    m_Localized: "Tsk\u2026\u2026!"
    m_Metadata:
      m_Items: []
  - m_Id: 306695508471808
    m_Localized: I can't believe Node lost...
    m_Metadata:
      m_Items: []
  - m_Id: 306696263446528
    m_Localized: 'Understood. We''ll rescue her immediately.

      With the Princess''s
      warp, we should still be able to catch up.

      Can you stand?'
    m_Metadata:
      m_Items: []
  - m_Id: 306696884203520
    m_Localized: 'Yeah...

      ...Sorry.'
    m_Metadata:
      m_Items: []
  - m_Id: 306697400102912
    m_Localized: "Alright, everyone\u2019s here!\nTime to save Milly-chan together!\nLet\u2019s
      gooo!"
    m_Metadata:
      m_Items: []
  - m_Id: 306697999888384
    m_Localized: "Let\u2019s go."
    m_Metadata:
      m_Items: []
  - m_Id: 306698943606784
    m_Localized: Node has joined!
    m_Metadata:
      m_Items: []
  - m_Id: 306700155760640
    m_Localized: Shit...!
    m_Metadata:
      m_Items: []
  - m_Id: 306700755546112
    m_Localized: Node!
    m_Metadata:
      m_Items: []
  - m_Id: 306701539880960
    m_Localized: ...You look pretty beat up.
    m_Metadata:
      m_Items: []
  - m_Id: 306701539880961
    m_Localized: What happened?
    m_Metadata:
      m_Items: []
  - m_Id: 306702571679744
    m_Localized: 'Shut up!

      I have to move... Milly...'
    m_Metadata:
      m_Items: []
  - m_Id: 306703460872192
    m_Localized: 'Your little sister?

      Calm yourself. Tell us what happened.'
    m_Metadata:
      m_Items: []
  - m_Id: 306704803049472
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 306704803049473
    m_Localized: '...The enemy took Milly.

      It was my fault...

      I wasn''t
      strong enough...!!'
    m_Metadata:
      m_Items: []
  - m_Id: 306705658687488
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 306705658687489
    m_Localized: '...You''re covered in injuries.

      Are you okay?'
    m_Metadata:
      m_Items: []
  - m_Id: 306707252523008
    m_Localized: "\u2026\u2026I'm fine."
    m_Metadata:
      m_Items: []
  - m_Id: 306707252523009
    m_Localized: That bastard... I'll be the one to take him down...!
    m_Metadata:
      m_Items: []
  - m_Id: 306709085433856
    m_Localized: ...Okay.
    m_Metadata:
      m_Items: []
  - m_Id: 306710666686464
    m_Localized: Get back here!!
    m_Metadata:
      m_Items: []
  - m_Id: 306712554123264
    m_Localized: "Milly! Hey\u2014Milly!! Are you okay!?"
    m_Metadata:
      m_Items: []
  - m_Id: 306713527201792
    m_Localized: "Big brother!\nIt\u2019s okay \u2014 Milly\u2019s fine!"
    m_Metadata:
      m_Items: []
  - m_Id: 306714504474624
    m_Localized: Thank goodness...!
    m_Metadata:
      m_Items: []
  - m_Id: 306715309780992
    m_Localized: "Well then, let\u2019s get out of here.\nThe adults should be arriving
      any minute now."
    m_Metadata:
      m_Items: []
  - m_Id: 306715309780993
    m_Localized: "Yeah... I\u2019d rather not get another lecture."
    m_Metadata:
      m_Items: []
  - m_Id: 306715309780994
    m_Localized: 'Ha ha ha!

      The hardships of an unofficial mission, eh?'
    m_Metadata:
      m_Items: []
  - m_Id: 306715309780995
    m_Localized: "Come on, Milly\u2026 \nCan you stand?"
    m_Metadata:
      m_Items: []
  - m_Id: 306715309780996
    m_Localized: Yes!
    m_Metadata:
      m_Items: []
  - m_Id: 306715850846208
    m_Localized: Thank you for playing with me, Player!
    m_Metadata:
      m_Items: []
  - m_Id: 306715850846209
    m_Localized: 'I''d love to keep talking with you, but...

      it looks like
      our connection is about to end.'
    m_Metadata:
      m_Items: []
  - m_Id: 306715850846210
    m_Localized: 'Promise you''ll come visit me again, okay?

      I''ll be waiting
      for you!'
    m_Metadata:
      m_Items: []
  - m_Id: 306716421271552
    m_Localized: Please add it to your wishlist and stay tuned for its release!
    m_Metadata:
      m_Items: []
  - m_Id: 306718006718464
    m_Localized: "Let\u2019s go too, Lulu-chan."
    m_Metadata:
      m_Items: []
  - m_Id: 306718006718465
    m_Localized: Yeah!
    m_Metadata:
      m_Items: []
  - m_Id: 306718006718466
    m_Localized: "\u2026\u2026Oh, wait!"
    m_Metadata:
      m_Items: []
  - m_Id: 306718665224192
    m_Localized: Hello?
    m_Metadata:
      m_Items: []
  - m_Id: 306718669418496
    m_Localized: 'Yeah, I met the Player!

      You were right, Boss!'
    m_Metadata:
      m_Items: []
  - m_Id: 306718669418497
    m_Localized: 'Huh? The plan?

      ...Oh. I forgot.'
    m_Metadata:
      m_Items: []
  - m_Id: 306718669418498
    m_Localized: 'Okay.

      See you later, Boss.'
    m_Metadata:
      m_Items: []
  - m_Id: 306719751548928
    m_Localized: 'We''ll meet again, Player.

      That''s a promise.'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
