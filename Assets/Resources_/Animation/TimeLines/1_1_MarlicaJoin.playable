  m_EditorClassIdentifier: 
  messageDatas:
  - text: "\u3046\u3093\u3001\u3042\u308A\u304C\u3068\u3046\uFF01"
    englishText: Yeah, thank you!
    characterIcon: {fileID: 21300000, guid: d901474487655db45aa0f3ee2bb5647e, type: 3}
    addShowTime: 0
  - text: "\u73FE\u5834\u306B\u884C\u304F\u3068\u3053\u3060\u3088\u306D\uFF1F\n\u4E00\u7DD2\u306B\u884C\u3053\u3046\uFF01"
    englishText: "We\u2019re off to the site, yeah?\nCome on, let's go together!"
    characterIcon: {fileID: 21300000, guid: 6a8e9ac36434ff24d935c3aab7895299, type: 3}
    addShowTime: 0
