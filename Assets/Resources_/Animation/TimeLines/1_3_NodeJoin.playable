  m_Name: MessagePlayableAsset(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  messageDatas:
  - text: "\u304A\u30FC\u3063\u3002"
    englishText: "Let\u2019s go."
    characterIcon: {fileID: 21300000, guid: fc7693bdc9c27c54f807d516e0905714, type: 3}
    addShowTime: 0
    isAutoForce: 0
    isUnScaledTime: 0
  shakeWindow: 0
