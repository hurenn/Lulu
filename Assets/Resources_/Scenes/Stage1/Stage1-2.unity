--- !u!1001 &319902959
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1716184300}
    m_Modifications:
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageListScript
      value: 
      objectReference: {fileID: 544547198}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.isForced
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[0].text
      value: "\u30DE\u30EB\u30EA\u30AB\u3002\u30DA\u30DA\u3068\u30CE\u30FC\u30C9\u306F\u898B\u304B\u3051\u305F\uFF1F"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[1].text
      value: "\u3046\u3046\u3093\u3002\u30EB\u30EB\u3061\u3083\u3093\u306E\u3053\u3068\u3057\u304B\u898B\u3048\u3066\u306A\u3044\u3088\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[2].text
      value: "\u305D\u3063\u304B\u30FC\u2026\u2026\u3002\u9014\u4E2D\u3067\u5408\u6D41\u3067\u304D\u305F\u3089\u3044\u3044\u3093\u3060\u3051\u3069\u306D\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[3].text
      value: "\u3044\u3001\u3044\u3084\u3001\u3044\u3064\u3082\u306A\u3089\u9003\u3052\u305F\u308A\u306A\u3093\u3066\u3057\u306A\u3044\u3093\u3060\u3088\uFF01\uFF1F"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[4].text
      value: "\u3042\u305F\u3057\u306F\u5B66\u5712\u9632\u885B\u90E8\u3068\u3057\u3066\u3001\u3044\u3064\u3082\u753A\u3092\u5B88\u3063\u3066\u308B\u3093\u3060\u304B\u3089\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[0].englishText
      value: Marlica, have you seen Pepe or Node?
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[0].isAutoForce
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[1].addShowTime
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[1].englishText
      value: "No. I\u2019ve only been able to see you, Lulu-chan."
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[1].isAutoForce
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[2].englishText
      value: "Got it\u2026 Hopefully we can run into them later."
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[0].characterIcon
