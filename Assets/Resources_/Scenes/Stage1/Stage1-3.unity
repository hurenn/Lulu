--- !u!1001 &2020247119
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageListScript
      value: 
      objectReference: {fileID: 544547198}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[0].text
      value: "\u3042\u308C\u3001\u3084\u308B\u305E\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[1].text
      value: "\u3042\u308C\uFF1F"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[2].text
      value: "\u3082\u3057\u304B\u3057\u3066\u3001\u5408\u4F53\u8D85\u5FC5\u6BBA\u6280\u307F\u305F\u3044\u306A\u3068\u3063\u3066\u304A\u304D\u306E\u4F55\u304B\u304C\u3042\u3063\u305F\u308A\u3059\u308B\u306E\uFF01\uFF1F"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[3].text
      value: "\u30ED\u30C3\u30AF\u30AA\u30F3\u653B\u6483\u3060\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[4].text
      value: "\u3042\u3042\u3001\u3042\u308C\u306D\u3002\n\u307E\u305A\u79C1\u306E\u708E\u3092\u5F53\u3066\u3066\u2026\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[5].text
      value: "\u3042\u30FC\u2026\u2026\u3002\u30ED\u30C3\u30AF\u30AA\u30F3\u3057\u3066\u304B\u3089Y\u30DC\u30BF\u30F3\u3092\u62BC\u305B\u3070\u3001\n\u3059\u3050\u9593\u5408\u3044\u306B\u30EF\u30FC\u30D7\u3057\u3066\u653B\u6483\u304C\u51FA\u6765\u308B\u3093\u3060\u3088\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[6].text
      value: "\u30CE\u30FC\u30C9\u306E\u653B\u6483\u306F\u30EA\u30FC\u30C1\u304C\u77ED\u3044\u304B\u3089\u3001\u307E\u305A\u306F\u708E\u3092\u5F53\u3066\u3066\u304B\u3089\u8FFD\u6483\u3059\u308B\u306E\u304C\u57FA\u672C\u3060\u306D\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[0].addShowTime
      value: -1
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[0].englishText
      value: Here we go.
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[1].addShowTime
      value: -1
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[1].englishText
      value: "Huh\u2026?"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[2].addShowTime
      value: -2
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[2].englishText
      value: Wait, do we have some kinda epic combo super move!?
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[3].addShowTime
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[3].englishText
      value: "Nah, it\u2019s just a lock-on attack."
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[4].addShowTime
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[4].englishText
      value: "Oh, that one. Hit \u2019em with my flres first\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[5].englishText
      value: "Okay\u2026 lock on, press Y, and bam. I warp right into range to attack."
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[6].englishText
      value: "Node's attack doesn\u2019t reach far, so the trick is to hit \u2019em
        with flames first and then follow up."
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[0].characterIcon
      value: 
      objectReference: {fileID: 21300000, guid: b3e32449b15eb9c449bfa16616c8e9ce, type: 3}
