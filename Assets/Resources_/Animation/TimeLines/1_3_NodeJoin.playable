  m_Name: MessagePlayableAsset(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  messageDatas:
  - text: "\u59B9\u541B\u304B\u3002\n\u843D\u3061\u7740\u3044\u3066\u304F\u308C\u3002\u4E00\u4F53\u4F55\u304C\u3042\u3063\u305F\uFF1F"
    englishText: 'Your little sister?

      Calm yourself. Tell us what happened.'
    characterIcon: {fileID: 21300000, guid: e94264859b55de64586a7bbfacd718b9, type: 3}
    addShowTime: 0
    isAutoForce: 0
    isUnScaledTime: 0
  shakeWindow: 0
  shakeIntensity: 20
  shakeDuration: 0.4
