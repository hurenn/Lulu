    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[0].text
      value: "B\u30DC\u30BF\u30F3\u3067\u30B8\u30E3\u30F3\u30D7\u3059\u308B\u3088\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[1].text
      value: "\u62BC\u3059\u9577\u3055\u3067\u3061\u3087\u3063\u3068\u3060\u3051\u8DDD\u96E2\u3082\u5909\u308F\u308B\u3093\u3060\u3051\u3069\u3001\u307E\u3042\u305D\u3093\u306A\u306B\u6C17\u306B\u3057\u306A\u304F\u3066\u3044\u3044\u3088\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[2].text
      value: "\u4ECA\u56DE\u306F\u30BF\u30A4\u30DF\u30F3\u30B0\u304C\u60AA\u304F\u3066\u3002\n\u3053\u3053\u304B\u3089\u3061\u3087\u3063\u3068\u9060\u3044\u3068\u3053\u306A\u3093\u3060\u3088\u306D\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[3].text
      value: "\u3055\u3002\u3053\u3093\u306A\u3068\u3053\u3055\u3063\u3055\u3068\u8131\u51FA\u3057\u3066\u3001\n\u307F\u3093\u306A\u3068\u5408\u6D41\u3057\u306A\u3044\u3068\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[0].addShowTime
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[0].englishText
      value: Press the B button to jump.
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[1].addShowTime
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[1].englishText
      value: "How long you press it changes the distance a bit, but don\u2019t sweat
        it."
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
