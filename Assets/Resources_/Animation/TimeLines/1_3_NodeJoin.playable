  m_EditorClassIdentifier: 
  messageDatas:
  - text: "\u5206\u304B\u3063\u305F\u3002\u3059\u3050\u306B\u52A9\u3051\u306B\u5411\u304B\u304A\u3046\u3002\n\u59EB\u306E\u30EF\u30FC\u30D7\u306A\u3089\u307E\u3060\u8FFD\u3044\u4ED8\u3051\u308B\u306F\u305A\u3060\u3002\n\u7ACB\u3066\u308B\u306A\uFF1F"
    englishText: 'Understood. We''ll rescue her immediately.

      With the Princess''s
      warp, we should still be able to catch up.

      Can you stand?'
    characterIcon: {fileID: 21300000, guid: f6389e54db455ce4aa0a012ed47c6a25, type: 3}
    addShowTime: 0
    isAutoForce: 0
