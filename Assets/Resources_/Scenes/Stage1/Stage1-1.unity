--- !u!1001 &1610957643
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageListScript
      value: 
      objectReference: {fileID: 544547198}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.isForced
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[0].text
      value: "\u30EF\u30FC\u30D7\u306B\u306FAP\u304C\u5FC5\u8981\u3060\u3051\u3069\u3001\u7740\u5730\u3059\u308C\u3070\u3059\u3050\u306B\u56DE\u5FA9\u3059\u308B\u3088\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[1].text
      value: "\u3042\u305F\u3057\u306E\u4ECA\u306EAP\u91CF\u306F\u3001\u982D\u306E\u4E0A\u306B\u51FA\u3057\u3066\u304A\u304F\u306D\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[2].text
      value: "AP\u304C\u7121\u304F\u306A\u308B\u3068\u3001\u5C11\u3057\u306E\u9593\u4F7F\u3048\u306A\u304F\u306A\u3063\u3061\u3083\u3046\u3051\u3069\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[3].text
      value: "\u307E\u3042\u305D\u308C\u3082\u3059\u3050\u56DE\u5FA9\u3059\u308B\u304B\u3089\u306D\u3002\n\u6C17\u306B\u305B\u305A\u30AC\u30F3\u30AC\u30F3\u4F7F\u3063\u3061\u3083\u304A\u3046\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[0].addShowTime
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[0].englishText
      value: Warping uses AP, but it recovers immediately once I land.
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[1].addShowTime
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[1].englishText
      value: "I\u2019ll display my current AP above my head."
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[2].addShowTime
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[2].englishText
      value: "If my AP runs out, I won\u2019t be able to use it for a short while."
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[3].addShowTime
