  m_EditorClassIdentifier: 
  messageDatas:
  - text: "\u30CE\u30FC\u30C9\u304C\u8CA0\u3051\u308B\u306A\u3093\u3066\u2026\u2026"
    englishText: I can't believe Node lost...
