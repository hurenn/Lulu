      value: "A\u3067\u30ED\u30C3\u30AF\u30AA\u30F3\u3057\u3066\u3001Y\u3067\u653B\u6483\uFF01\n\u3053\u306E\u6D41\u308C\u304C\u57FA\u672C\u3060\u306D\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[5].text
      value: "A\u3067\u6575\u3092\u30ED\u30C3\u30AF\u30AA\u30F3\uFF01\n\u305D\u306E\u307E\u307EY\u9023\u6253\u3067\u3001\u3069\u3053\u304B\u3089\u3067\u3082\u30B3\u30F3\u30DC\u653B\u6483\u3092\u5F53\u3066\u3061\u3083\u304A\u3046\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[6].text
      value: "\u3042\u3002\u3061\u306A\u307F\u306B\u3001\u30DE\u30EB\u30EA\u30AB\u306F\u4F11\u61A9\u4E2D\u306B\u5C11\u3057\u305A\u3064\u5FC5\u6BBA\u6280\u30B2\u30FC\u30B8\u304C\u6E9C\u307E\u3063\u3066\u3044\u304F\u3093\u3060\u3088\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[7].text
      value: "A\u30DC\u30BF\u30F3\u304C\u5149\u3063\u305F\u3089\u3001\u5FC5\u6BBA\u6280\u30C1\u30E3\u30FC\u30B8\u5B8C\u4E86\uFF01\n\u3042\u305F\u3057\u3068\u30DE\u30EB\u30EA\u30AB\u306E\u5FC5\u6BBA\u6280\u3092\u304A\u898B\u821E\u3044\u3057\u3088\u3046\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[8].text
      value: "\u3042\u3044\u3064\u306F\u6575\u3060\u3002\n\u7D76\u5BFE\u306B\u8FFD\u3044\u4ED8\u3044\u3066\u3076\u3063\u5012\u3057\u3066\u3084\u308B\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[9].text
      value: "\u9811\u5F35\u308D\u3046\u306D\u3002\u30EB\u30EB\u3061\u3083\u3093\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[10].text
      value: "\u3046\u3093\uFF01\n\u305D\u306E\u305F\u3081\u306E\u3001\u3042\u305F\u3057\u305F\u3061\u5B66\u5712\u9632\u885B\u90E8\u306A\u3093\u3060\u304B\u3089\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[11].text
      value: "\u30D7\u30EC\u30A4\u30E4\u30FC\u3082\u3001\u3042\u305F\u3057\u305F\u3061\u306E\u4EF2\u9593\u3060\u3088\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[12].text
      value: "\u4E00\u7DD2\u306B\u60AA\u306E\u7D44\u7E54\u3092\u5012\u3057\u3066\u3001\u30DF\u30EA\u30FC\u3061\u3083\u3093\u3092\u52A9\u3051\u51FA\u305D\u3046\u306D\uFF01"
      objectReference: {fileID: 0}
