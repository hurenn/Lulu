  m_EditorClassIdentifier: 
  messageDatas:
  - text: "\u2026\u2026\u3053\u308C\u304F\u3089\u3044\u4F55\u3067\u3082\u306D\u3048\u3088\u3002"
    englishText: "\u2026\u2026I'm fine."
    characterIcon: {fileID: 21300000, guid: 3727daa9959b89b47aacc2acbc499d30, type: 3}
    addShowTime: 0
    isAutoForce: 0
    isUnScaledTime: 0
  - text: "\u3042\u3044\u3064\u3060\u3051\u306F\u2026\u2026\u30AA\u30EC\u304C\u5012\u3059\u2026\u2026\uFF01"
    englishText: That bastard... I'll be the one to take him down...!
    characterIcon: {fileID: 21300000, guid: 87bc8f26727f6314fa5bd0de176dcf25, type: 3}
    addShowTime: 0
