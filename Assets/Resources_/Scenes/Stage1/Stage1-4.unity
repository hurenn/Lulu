    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[0].addShowTime
      value: -1
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[0].englishText
      value: "Something\u2019s coming!"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[1].addShowTime
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[1].englishText
      value: <color=yellow>Keep holding the X button!
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[2].englishText
      value: "\u2026Like a cat that climbs up and can\u2019t get down?"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[3].englishText
      value: Maybe he hates low ground.
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[4].englishText
      value: Ugh, who cares. Quit rambling.
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[5].englishText
      value: "They\u2014 their organization took my sister\u2026!"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[6].englishText
      value: "A criminal organization!\u3000Give Milly back. Now!!"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
