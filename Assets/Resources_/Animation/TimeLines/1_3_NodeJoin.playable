  m_EditorClassIdentifier: 
  messageDatas:
  - text: "\u2026\u2026\uFF01\n\u30DF\u30EA\u30FC\u3061\u3083\u3093\u304C\u2026\u2026\uFF01\uFF1F"
    englishText: "\u2026\u2026!\nMilly-chan\u2026\u2026!?"
    characterIcon: {fileID: 21300000, guid: 887f920c5800bbb48b26bb17209ab125, type: 3}
    addShowTime: 0
    isAutoForce: 0
--- !u!114 &-3031798383866123284
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9d01984c64812b9448751b37fd617dba, type: 3}
  m_Name: MessagePlayableAsset(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  messageDatas:
  - text: "\u2026\u2026\u5927\u4E08\u592B\uFF1F\n\u30B1\u30AC\u3057\u3066\u308B\u307F\u305F\u3044\u3060\u3051\u3069\u3002"
    englishText: "\u2026Are you okay?\nLooks like you\u2019re hurt."
    characterIcon: {fileID: 21300000, guid: 21a616f61046fb34bb4c24fcd3501c06, type: 3}
    addShowTime: 0
    isAutoForce: 0
  - text: "\u2026\u2026\u5927\u4E08\u592B\u3060\u3002\u3042\u306E\u6575\u306F\u4FFA\u304C\u5012\u3059\u2026\u2026\uFF01\n\u7D76\u5BFE\u306B\u2026\u2026\uFF01\uFF01"
    englishText: "I\u2019m fine. I\u2019ll take that enemy down\u2026\nNo matter
      what\u2026!!"
    characterIcon: {fileID: 21300000, guid: 87bc8f26727f6314fa5bd0de176dcf25, type: 3}
    addShowTime: 0
    isAutoForce: 0
  - text: "\u2026\u2026\u305D\u3046\u3002"
    englishText: "\u2026I see."
    characterIcon: {fileID: 21300000, guid: 3a358e054af59bb4d8188da9d8fd5afe, type: 3}
    addShowTime: 0
    isAutoForce: 0
