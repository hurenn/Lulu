--- !u!114 &-2640439687664618081
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9d01984c64812b9448751b37fd617dba, type: 3}
  m_Name: MessagePlayableAsset(Clone)(Clone)
  m_EditorClassIdentifier: 
  messageDatas:
  - text: "\u3082\u3057\u3082\u3057\uFF1F"
    englishText: Hello?
    characterIcon: {fileID: 21300000, guid: 84a90998f9c38024486e890e57afc0a3, type: 3}
    addShowTime: 0
    isAutoForce: 0
    isUnScaledTime: 0
  - text: "\u3046\u3093\u3001\u30D7\u30EC\u30A4\u30E4\u30FC\u306B\u4F1A\u3048\u305F\u3088\uFF01\n\u30DC\u30B9\u306E\u8A00\u3063\u305F\u901A\u308A\u3060\u3063\u305F\uFF01"
    englishText: 'Yeah, I met the Player!

      You were right, Boss!'
    characterIcon: {fileID: 21300000, guid: 84a90998f9c38024486e890e57afc0a3, type: 3}
    addShowTime: 0
    isAutoForce: 0
    isUnScaledTime: 0
  - text: "\u3048\u3001\u8A08\u753B\uFF1F\n\u2026\u2026\u3042\u3002\u5FD8\u308C\u3066\u305F\u3002"
    englishText: 'Huh? The plan?

      ...Oh. I forgot.'
    characterIcon: {fileID: 21300000, guid: 84a90998f9c38024486e890e57afc0a3, type: 3}
    addShowTime: 0
    isAutoForce: 0
    isUnScaledTime: 0
  - text: "\u306F\u30FC\u3044\u3002\n\u3058\u3083\u3042\u307E\u305F\u306D\u3002\u30DC\u30B9\u3002"
    englishText: 'Okay.

      See you later, Boss.'
    characterIcon: {fileID: 21300000, guid: 84a90998f9c38024486e890e57afc0a3, type: 3}
    addShowTime: 0
    isAutoForce: 0
    isUnScaledTime: 0
  shakeWindow: 0
  shakeIntensity: 20
  shakeDuration: 0.4
--- !u!114 &-2622875884853020488
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9d01984c64812b9448751b37fd617dba, type: 3}
  m_Name: MessagePlayableAsset(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  messageDatas:
  - text: "\u2026\u2026\u307E\u305F\u4F1A\u304A\u3046\u306D\u3002\u30D7\u30EC\u30A4\u30E4\u30FC\u3002\n\u7D76\u5BFE\u3060\u3088\u3002"
    englishText: 'We''ll meet again, Player.

      That''s a promise.'
    characterIcon: {fileID: 21300000, guid: 84a90998f9c38024486e890e57afc0a3, type: 3}
    addShowTime: 0
    isAutoForce: 0
    isUnScaledTime: 0
  shakeWindow: 0
  shakeIntensity: 20
  shakeDuration: 0.4
