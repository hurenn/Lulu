      value: "\u3042\u3002\u982D\u306E\u4E0A\u306E<color=yellow>\u30B2\u30FC\u30B8\u3092\u4F7F\u3044\u5207\u308B</color>\u3068\u3001\u3057\u3070\u3089\u304F<color=yellow>\u30EF\u30FC\u30D7\u51FA\u6765\u306A\u304F</color>\u306A\u3063\u3061\u3083\u3046\u3093\u3060\u3088\u3002"
