    addShowTime: 0
    isAutoForce: 0
  - text: "\u59B9\u304C\u2026\u2026\u9023\u308C\u53BB\u3089\u308C\u305F\u2026\u2026\uFF01"
    englishText: "My little sister\u2026 has been taken\u2026!"
    characterIcon: {fileID: 21300000, guid: 68f872cf0e39f3c4681da717c50adcfc, type: 3}
    addShowTime: 0
    isAutoForce: 0
