  - text: "\u3082\u3063\u3068\u305F\u304F\u3055\u3093\u304A\u8A71\u3057\u305F\u3044\u3051\u3069\u2026\u2026\n\u4ECA\u65E5\u306F\u3082\u3046\u3059\u3050\u63A5\u7D9A\u304C\u5207\u308C\u3061\u3083\u3046\u307F\u305F\u3044\u3002"
    englishText: 'I''d love to keep talking with you, but...

      it looks like
      our connection is about to end.'
    characterIcon: {fileID: 21300000, guid: 84a90998f9c38024486e890e57afc0a3, type: 3}
    addShowTime: 0
    isAutoForce: 0
    isUnScaledTime: 0
  - text: "\u3042\u306E\u306D\u3001\u307E\u305F\u904A\u3073\u306B\u6765\u3066\u306D\uFF01\n\u5F85\u3063\u3066\u308B\u3088\uFF01"
    englishText: 'Promise you''ll come visit me again, okay?

      I''ll be waiting
      for you!'
    characterIcon: {fileID: 21300000, guid: 84a90998f9c38024486e890e57afc0a3, type: 3}
    addShowTime: 0
    isAutoForce: 0
    isUnScaledTime: 0
  shakeWindow: 0
  shakeIntensity: 20
  shakeDuration: 0.4
