--- !u!1001 &6652013
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageListScript
      value: 
      objectReference: {fileID: 544547198}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[0].text
      value: "\u5149\u7DDA\u304C\u898B\u3048\u305F\u3089\u30EC\u30FC\u30B6\u30FC\u304C\u98DB\u3093\u3067\u304F\u308B\u305E\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[1].text
      value: "<color=yellow>X\u30DC\u30BF\u30F3\u3067\u7121\u6575</color>\u306B\u306A\u308C\u308B\u3053\u3068\u3092\u5FD8\u308C\u305A\u306B\u306A\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[2].text
      value: "\u30EB\u30EB\u3061\u3083\u3093\u306A\u3089\u7121\u6575\u306B\u306A\u3089\u306A\u304F\u3066\u3082\n\u907F\u3051\u3089\u308C\u308B\u3093\u3058\u3083\u306A\u3044\uFF1F"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[3].text
      value: "\u4EFB\u305B\u3066\uFF01\n\u5149\u7DDA\u3092\u907F\u3051\u308C\u3070\u3044\u3044\u3093\u3060\u3088\u306D\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[4].text
      value: "\u7279\u306B\u30C7\u30E1\u30EA\u30C3\u30C8\u306F\u306A\u3044\u304B\u3089\n\u50D5\u306E\u80FD\u529B\u3082\u4F7F\u3063\u3066\u3084\u3063\u3066\u304F\u308C\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[5].text
      value: "\u2026\u2026\u30AA\u30EC\u306F\u8CA0\u3051\u3066\u306D\u3048\uFF01\n\u307E\u3060\u6226\u3048\u305F\u306E\u306B\u3042\u3044\u3064\u304C\u9003\u3052\u305F\u3093\u3060\u3088\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[6].text
      value: "\u3064\u307E\u308A\u4ECA\u3001\u3053\u3053\u3067\u5012\u305B\u3070\u30AA\u30EC\u306E\u52DD\u3061\u3060\uFF01\n\u7D76\u5BFE\u306B\u9003\u304C\u3059\u306A\u3088\uFF01\u884C\u304F\u305E\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[7].text
      value: "\u305D\u3046\u304B\uFF1F \u3042\u308C\u306E\u305B\u3044\u3067\u91CD\u304F\u3066\u3001\u3042\u305D\u3053\u304B\u3089\u52D5\u3051\u306D\u3048\u3093\u3058\u3083\u306D\u3048\u306E\u304B\uFF1F"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[8].text
      value: "\u2026\u2026\u4E0A\u3063\u305F\u3089\u4E0B\u308A\u3089\u308C\u306A\u3044\u732B\u304B\u306A\uFF1F"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[9].text
      value: "\u4F4E\u6240\u6050\u6016\u75C7\u306A\u306E\u304B\u3082\u3057\u308C\u3093\u305E\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[10].text
      value: "\u3044\u3084\u305D\u3093\u306A\u3053\u3068\u306F\u3069\u3046\u3067\u3082\u3044\u3044\u3093\u3060\u3088\u3002\n\u8A71\u5E83\u3052\u3093\u306A\u3088\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[11].text
      value: "\u3053\u3044\u3064\u304C\u2026\u2026\u3053\u3044\u3064\u3089\u306E\u7D44\u7E54\u304C\u3001\u30DF\u30EA\u30FC\u3092\u9023\u308C\u53BB\u3063\u305F\u3093\u3060\u2026\u2026\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[12].text
      value: "\u60AA\u306E\u7D44\u7E54\u304C\uFF01 \u3055\u3063\u3055\u3068\u30DF\u30EA\u30FC\u3092\u8FD4\u305B\uFF01\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[13].text
      value: "\u60AA\u306E\u7D44\u7E54\u304C\uFF01 \u3055\u3063\u3055\u3068\u30DF\u30EA\u30FC\u3092\u8FD4\u305B\uFF01\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[0].englishText
      value: When you see the warning beam, the laser's coming.
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[1].addShowTime
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[1].englishText
      value: 'Don''t forget!

        <color=yellow>Hold X to become invincible!</color>'
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[2].addShowTime
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[2].englishText
      value: Lulu-chan, couldn't you dodge them even without becoming invincible?
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[3].englishText
      value: 'Leave it to me!

        I just have to dodge the warning beam, right?'
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[4].englishText
      value: There's no downside, so make good use of my ability too!
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[5].englishText
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[6].englishText
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[7].englishText
      value: "Really? I bet it\u2019s super heavy, he won\u2019t be moving anywhere
        from there."
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[8].englishText
      value: "\u2026Like a cat that climbs up and can\u2019t get down?"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[9].englishText
      value: Maybe he hates low ground.
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[10].englishText
      value: Ugh, who cares. Quit rambling.
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[11].englishText
      value: "They\u2014 their organization took my sister\u2026!"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[12].englishText
      value: "A criminal organization!\u3000Give Milly back. Now!!"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
      propertyPath: _messageDatas.messageDatas.Array.data[13].englishText
      value: "A criminal organization!\u3000Give Milly back. Now!!"
      objectReference: {fileID: 0}
    - target: {fileID: 512709528090022214, guid: 9a4d519b2e46a55498391b25dbe6dc79, type: 3}
