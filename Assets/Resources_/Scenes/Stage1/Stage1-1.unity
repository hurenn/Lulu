      value: "\u7A7A\u4E2D\u3067\u5341\u5B57\u30AD\u30FC\u3092\u62BC\u3057\u305F\u307E\u307EB\u30DC\u30BF\u30F3\u3092\u62BC\u3059\u3068\u3001\u30EF\u30FC\u30D7\u3067\u304D\u308B\u3088\u3002"
